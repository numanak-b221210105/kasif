# Kopyalayıp .env olarak kaydedin. .env dosyası git'e gönderilmez.
# Hiçbiri zorunlu değil: LLM yoksa Kâşif kural motoruyla çalışır.

# Varsayılan: bilgisayarınızda çalışan ücretsiz Ollama (https://ollama.com)
#   ollama pull qwen2.5-coder:7b   -> serbest sorular için SQL yazan model
KASIF_LLM_BASE_URL=http://localhost:11434/v1
KASIF_LLM_API_KEY=ollama
KASIF_LLM_MODEL=qwen2.5-coder:7b

# Veri setlerinin ve sorgu geçmişinin saklandığı klasör
KASIF_DATA_DIR=data

# Güvenlik sınırları
KASIF_MAX_ROWS=1000
KASIF_TIMEOUT_S=5

# OpenAI uyumlu başka bir sağlayıcı örneği:
# KASIF_LLM_BASE_URL=https://api.openai.com/v1
# KASIF_LLM_API_KEY=sk-...
# KASIF_LLM_MODEL=<sağlayıcının güncel model adı>
